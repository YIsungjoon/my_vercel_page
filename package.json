{
	"name": "my-vercel-page",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "node scripts/prepare-services.mjs && vite dev --port 5173 --strictPort",
		"dev:frontend": "npm run dev:agri",
		"dev:agri": "npm --prefix project/dreaming_agri/frontend run dev -- --port 5174 --strictPort",
		"dev:backend": "npm --prefix backend run dev",
		"stop:backend": "npm --prefix backend run stop",
		"status:backend": "npm --prefix backend run status",
		"test:backend": "npm --prefix backend run db:test",
		"lint:backend": "npm --prefix backend run db:lint",
		"install:backend": "npm --prefix backend ci",
		"build": "node scripts/prepare-services.mjs && vite build",
		"preview": "vite preview",
		"prepare": "node scripts/prepare-services.mjs",
		"check": "node scripts/prepare-services.mjs && svelte-check --tsconfig ./tsconfig.json",
		"check:agri": "npm --prefix project/dreaming_agri/frontend run check",
		"check:all": "npm run check && npm run check:agri && npm run check:practice",
		"build:agri": "npm --prefix project/dreaming_agri/frontend run build",
		"install:agri": "npm --prefix project/dreaming_agri/frontend ci && npm run install:backend",
		"dev:practice": "npm --prefix project/ai-practice run dev",
		"install:practice": "npm --prefix project/ai-practice ci",
		"check:practice": "npm --prefix project/ai-practice run check",
		"test:practice": "npm --prefix project/ai-practice test",
		"build:practice": "npm --prefix project/ai-practice run build"
	},
	"devDependencies": {
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^22.20.5",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@supabase/ssr": "0.12.3",
		"@supabase/supabase-js": "2.110.5"
	}
}
